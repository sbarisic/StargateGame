<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsRidAgnostic>false</IsRidAgnostic>
    <NativeAudioSourceDirectory>$(MSBuildProjectDirectory)\..\..\native\StargateAudioNative</NativeAudioSourceDirectory>
    <MiniaudioRoot>$(MSBuildProjectDirectory)\..\..\vendor\miniaudio</MiniaudioRoot>
    <NativeAudioBuildDirectory>$(MSBuildProjectDirectory)\obj\native\$(Configuration)</NativeAudioBuildDirectory>
    <NativeAudioBinary>$(NativeAudioBuildDirectory)\$(Configuration)\StargateAudioNative.dll</NativeAudioBinary>
    <BuildStargateAudioNative Condition="'$(BuildStargateAudioNative)' == '' and '$(OS)' == 'Windows_NT'">true</BuildStargateAudioNative>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>StargateGame.Audio.Tests</_Parameter1>
    </AssemblyAttribute>
    <None Include="$(NativeAudioBinary)"
          Link="StargateAudioNative.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(BuildStargateAudioNative)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildStargateAudioNative)' == 'true'">
    <_StargateAudioNativeBuildInput Include="$(MSBuildProjectFullPath)" />
    <_StargateAudioNativeBuildInput Include="$(MSBuildProjectDirectory)\..\..\scripts\Build-NativeAudio.ps1" />
    <_StargateAudioNativeBuildInput Include="$(NativeAudioSourceDirectory)\CMakeLists.txt" />
    <_StargateAudioNativeBuildInput Include="$(NativeAudioSourceDirectory)\src\**\*.c" />
    <_StargateAudioNativeBuildInput Include="$(NativeAudioSourceDirectory)\include\**\*.h" />
    <_StargateAudioNativeBuildInput Include="$(MiniaudioRoot)\miniaudio.c" />
    <_StargateAudioNativeBuildInput Include="$(MiniaudioRoot)\miniaudio.h" />
  </ItemGroup>

  <Target Name="ResolveVoxelAudioToolchain"
          Condition="'$(BuildStargateAudioNative)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Build-NativeAudio.ps1&quot; -Configuration &quot;$(Configuration)&quot; -CMakeExecutable &quot;$(CMakeExecutable)&quot; -OutputFile &quot;$(NativeAudioBinary)&quot; -BuildDirectory &quot;$(NativeAudioBuildDirectory)&quot; -ResolveOnly" />
  </Target>

  <Target Name="BuildStargateAudioNative"
          BeforeTargets="PrepareForBuild;Publish"
          DependsOnTargets="ResolveVoxelAudioToolchain"
          Inputs="@(_StargateAudioNativeBuildInput);$(NativeAudioBuildDirectory)\native-toolchain.json"
          Outputs="$(NativeAudioBinary)"
          Condition="'$(BuildStargateAudioNative)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\Build-NativeAudio.ps1&quot; -Configuration &quot;$(Configuration)&quot; -CMakeExecutable &quot;$(CMakeExecutable)&quot; -OutputFile &quot;$(NativeAudioBinary)&quot; -BuildDirectory &quot;$(NativeAudioBuildDirectory)&quot;" />
  </Target>

</Project>
